# 脱敏版 .env-backend 模板：值为 CHANGE_ME 的设置涉及安全或基础功能，请务必修改

# site name
SITE_NAME=Moeflow
SITE_ORIGIN=https://CHANGE_ME.example.com

# encrypt key of user sessions.
SECRET_KEY=CHANGE_ME

# auto-created admin user and password
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# mongodb database（由 docker-compose.yml 注入，此处无需再写）
# MONGODB_URI=mongodb://moeflow:CHANGE_ME@moeflow-mongodb:27017/moeflow?authSource=admin

# celery broker（已切换 Redis，由 docker-compose.yml 注入）
# CELERY_BROKER_URL=redis://moeflow-redis:6379/0

# -----------
# Storage 配置
# -----------
# 目前支持 LOCAL_STORAGE 和 OSS
STORAGE_TYPE=LOCAL_STORAGE
# STORAGE_DOMAIN: 返回给客户端的图片URL前缀
# 1. 如果STORAGE_TYPE为OSS
#   - 未设置自定义域名则填写阿里云提供的 OSS 域名，格式如：https://<your-bucket-name>.<oss-region>.aliyuncs.com/
#   - 如果绑定了 CDN 来加速 OSS，则填写绑定在 CDN 的域名
# 2. 如果STORAGE_TYPE为LOCAL_STORAGE
#   - 本地储存填写绑定到服务器的域名+"/storage/"，格式如：http(s)://<your-domain>.com/storage/，
STORAGE_DOMAIN=https://CHANGE_ME.example.com/storage/

## OSS_*: STORAGE_TYPE为OSS时的配置
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_PROCESS_COVER_NAME=cover
OSS_PROCESS_SAFE_CHECK_NAME=safe-check

# -----------
# CDN 配置
# -----------
OSS_VIA_CDN=True
CDN_URL_KEY_A=
CDN_URL_KEY_B=

# -----------
# Email 已停用（本轮已移除邮件发送链路），以下配置仅为兼容保留
# -----------
ENABLE_USER_EMAIL=False
ENABLE_LOG_EMAIL=False
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_USE_SSL=True
EMAIL_ADDRESS=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_REPLY_ADDRESS=
EMAIL_ERROR_ADDRESS=
